APP_NAME=numeria
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root_pass

POSTGRES_MULTIPLE_DATABASES=users_db,study_db,game_db,crisis_db,career_db,ai_db,notifications_db

DB_NAME_USERS=users_db
DB_NAME_STUDY=study_db
DB_NAME_GAME=game_db
DB_NAME_CRISIS=crisis_db
DB_NAME_CAREER=career_db
DB_NAME_AI=ai_db
DB_NAME_NOTIFICATIONS=notifications_db

JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=/app/certs/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/app/certs/jwt_private.pem
ACCESS_TOKEN_EXPIRE_MINUTES=60

S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET_NAME=numeria-bucket
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_REGION=ru-central1
S3_USE_SSL=true

GIGACHAT_API_KEY=your_gigachat_api_key_here